FROM node:20-alpine

RUN apk add --no-cache postgresql-client tini

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci --legacy-peer-deps --ignore-scripts && npx prisma generate

COPY tsconfig.json ./
COPY prisma.config.ts ./
COPY scripts ./scripts

RUN mkdir -p /app/uploads /app/uploads/storage /app/logs && \
    addgroup -S app -g 1001 && \
    adduser -S app -u 1001 -G app && \
    chown -R app:app /app

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

COPY scripts/docker-entrypoint.dev.sh ./docker-entrypoint.dev.sh
RUN chmod +x ./docker-entrypoint.dev.sh

USER app

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./docker-entrypoint.dev.sh"]
